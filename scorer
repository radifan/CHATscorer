    async function runAIAudit() {
      const inputVal = document.getElementById('input-url')?.value || "";
      const url = normalizeUrl(inputVal);
      if (!url) {
        showToast("URL Diperlukan", "Masukkan URL website UMKM terlebih dahulu.", false);
        return;
      }

      state.url = url;

      if (state.auditCache[url]) {
