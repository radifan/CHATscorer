<!DOCTYPE html>
<html lang="id" class="dark h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Penilaian Prototipe WebApp UMKM</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Firebase JS SDK Modules for Public Cloud Access -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { getFirestore, doc, getDoc, setDoc, collection, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    window.FirebaseSDK = {
      initializeApp,
      getAuth,
      signInAnonymously,
      signInWithCustomToken,
      getFirestore,
      doc,
      getDoc,
      setDoc,
      collection,
      onSnapshot
    };
  </script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#f0f9ff',
              100: '#e0f2fe',
              500: '#0ea5e9',
              600: '#0284c7',
              700: '#0369a1',
            }
          }
        }
      }
    }
  </script>

  <style>
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #0f172a;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }
    
    .device-desktop { width: 100%; height: 600px; }
    .device-tablet { width: 768px; height: 600px; }
    .device-mobile { width: 375px; height: 600px; }

    @media print {
      body * {
        visibility: hidden;
      }
      #print-report-modal, #print-report-modal * {
        visibility: visible;
      }
      #print-report-modal {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        background: white !important;
        color: black !important;
        padding: 0 !important;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>

<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-full flex flex-col custom-scrollbar">

  <header class="bg-slate-900/90 backdrop-blur-md border-b border-slate-800 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 via-indigo-500 to-purple-600 flex items-center justify-center text-white shadow-lg shadow-sky-500/20">
          <i class="fa-solid fa-store text-lg"></i>
        </div>
        <div>
          <h1 class="font-extrabold text-sm sm:text-base text-slate-100 tracking-tight flex items-center gap-2">
            Audit Prototipe WebApp UMKM
            <span class="text-[10px] bg-sky-950 text-sky-400 border border-sky-800 font-mono px-2 py-0.5 rounded-full">v3.0 Cloud</span>
          </h1>
          <p class="text-[11px] text-slate-400 hidden sm:block">Sistem Penilaian Otomatis 10 Kriteria Berbasis Gemini AI</p>
        </div>
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <div class="hidden md:flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-950/60 border border-emerald-800 text-emerald-400 text-xs font-mono">
          <i class="fa-solid fa-lock text-emerald-400"></i>
          <span>Mode Konsisten (Temp 0.0)</span>
        </div>

        <button id="btn-toggle-public-repo" class="px-3 py-1.5 rounded-lg border border-sky-800 bg-sky-950/80 hover:bg-sky-900 text-sky-300 hover:text-white text-xs font-medium transition flex items-center gap-2">
          <i class="fa-solid fa-globe text-sky-400"></i>
          <span>Repositori Publik</span>
        </button>

        <button id="btn-open-api-modal" class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-medium transition flex items-center gap-2">
          <i class="fa-solid fa-key text-amber-400"></i>
          <span id="api-status-label" class="hidden sm:inline">Kunci Gemini API</span>
        </button>

        <button id="btn-export-pdf" class="px-3.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold shadow-md shadow-emerald-600/20 transition flex items-center gap-2">
          <i class="fa-solid fa-file-pdf"></i>
          <span>Cetak PDF</span>
        </button>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">

    <!-- Copy Notification Toast -->
    <div id="toast-notification" class="hidden fixed top-20 right-4 z-50 bg-emerald-900 border border-emerald-700 text-emerald-100 px-4 py-3 rounded-xl shadow-2xl flex items-center gap-3 transition-all duration-300">
      <i class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
      <div>
        <h4 class="font-bold text-xs" id="toast-title">Berhasil!</h4>
        <p class="text-[11px] text-emerald-200" id="toast-message">Tautan audit publik telah disalin ke clipboard.</p>
      </div>
    </div>

    <!-- Input Section -->
    <section class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 sm:p-6 shadow-2xl relative overflow-hidden">
      <div class="absolute -right-12 -top-12 w-48 h-48 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-col gap-4 relative z-10">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-sm font-bold text-slate-200 flex items-center gap-2">
              <i class="fa-solid fa-globe text-sky-400"></i> URL Prototipe Website UMKM
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">Masukkan 1 URL utama prototipe. AI Gemini akan mengevaluasi secara otomatis seluruh 10 kriteria, termasuk pemindaian tautan portal admin pada navigasi/footer website.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 items-center">
          <div class="lg:col-span-9 relative">
            <label for="input-url" class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">URL Utama Prototipe Website UMKM:</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                <i class="fa-solid fa-link text-xs"></i>
              </div>
              <input type="text" id="input-url" value="https://kopi-lokal-nusantara.vercel.app" class="w-full pl-9 pr-28 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-slate-100 placeholder-slate-500 text-xs focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 font-mono">
              <button id="btn-load-preview" title="Muat Tampilan Preview" class="absolute right-1 top-1 bottom-1 px-3 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-lg transition flex items-center gap-1.5 shadow">
                <i class="fa-solid fa-eye text-sky-400 text-xs"></i> <span>Preview</span>
              </button>
            </div>
          </div>

          <div class="lg:col-span-3 pt-2 lg:pt-5">
            <button id="btn-audit-ai" class="w-full h-[42px] bg-gradient-to-r from-sky-500 via-blue-600 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 text-white text-xs font-bold rounded-xl shadow-lg shadow-sky-500/25 transition flex items-center justify-center gap-2 group">
              <i class="fa-solid fa-wand-magic-sparkles text-amber-300 group-hover:rotate-12 transition transform"></i>
              <span>Nilai Prototipe Sekarang</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <section id="preview-section" class="hidden bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl transition-all duration-300">
      <div class="p-3 bg-slate-900 border-b border-slate-800 flex items-center justify-between gap-2 flex-wrap">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-xs font-bold text-slate-300 flex items-center gap-1.5">
            <i class="fa-solid fa-display text-sky-400"></i> Tampilan Prototipe Live:
          </span>
          <div class="flex items-center gap-1 bg-slate-950 p-1 rounded-lg border border-slate-800">
            <button id="device-desktop" class="btn-device active px-2.5 py-1 rounded-md text-xs font-medium text-sky-400 bg-slate-800 transition flex items-center gap-1.5">
              <i class="fa-solid fa-desktop"></i> Desktop (1280px)
            </button>
            <button id="device-tablet" class="btn-device px-2.5 py-1 rounded-md text-xs font-medium text-slate-400 hover:text-slate-200 transition flex items-center gap-1.5">
              <i class="fa-solid fa-tablet-screen-button"></i> Tablet (768px)
            </button>
            <button id="device-mobile" class="btn-device px-2.5 py-1 rounded-md text-xs font-medium text-slate-400 hover:text-slate-200 transition flex items-center gap-1.5">
              <i class="fa-solid fa-mobile-screen-button"></i> Mobile (375px)
            </button>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <span id="preview-url-status" class="text-[11px] font-mono text-sky-400 bg-slate-950 px-2.5 py-1 rounded-lg border border-slate-800 max-w-xs truncate hidden sm:inline-block">
            Menampilkan: -
          </span>
          <button id="btn-reload-iframe" title="Muat Ulang Frame" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs transition">
            <i class="fa-solid fa-rotate-right"></i>
          </button>
          <a id="link-external-open" href="#" target="_blank" rel="noopener noreferrer" title="Buka di Tab Baru" class="px-2.5 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-500 text-white text-xs font-medium transition flex items-center gap-1.5">
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
            <span class="hidden md:inline">Buka di Tab Baru</span>
          </a>
        </div>
      </div>

      <div id="iframe-fallback-banner" class="bg-amber-950/40 border-b border-amber-800/60 px-4 py-2 text-amber-300 text-xs flex items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-circle-info text-amber-400"></i>
          <span>Jika website target memblokir preview iframe (<code class="bg-amber-950 px-1 py-0.5 rounded font-mono">X-Frame-Options</code>), gunakan tombol 'Buka di Tab Baru' untuk memverifikasi situs secara langsung.</span>
        </div>
        <a id="banner-open-link" href="#" target="_blank" class="underline font-bold hover:text-amber-100 whitespace-nowrap">Buka Tab Baru &rarr;</a>
      </div>

      <div class="bg-slate-950 p-4 flex items-center justify-center overflow-auto custom-scrollbar min-h-[500px]">
        <div id="iframe-wrapper" class="device-desktop transition-all duration-300 bg-white rounded-xl overflow-hidden shadow-2xl relative border border-slate-700">
          <div id="iframe-loading" class="hidden absolute inset-0 bg-slate-950/80 backdrop-blur-sm flex flex-col items-center justify-center gap-3 z-10 text-slate-200">
            <i class="fa-solid fa-circle-notch fa-spin text-3xl text-sky-400"></i>
            <p class="text-xs font-medium">Memuat Tampilan Prototipe...</p>
          </div>
          <iframe id="preview-iframe" src="about:blank" class="w-full h-full border-0"></iframe>
        </div>
      </div>
    </section>

    <div id="results-section" class="hidden space-y-8 transition-all duration-300">

      <!-- Executive Summary & Radar Section -->
      <section class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-slate-800 pb-4">
          <div>
            <h2 class="text-base sm:text-lg font-bold text-slate-100 flex items-center gap-2">
              <i class="fa-solid fa-chart-line text-sky-400"></i>
              Hasil Penilaian Eksekutif Auditor AI
            </h2>
            <p class="text-xs text-slate-400">Skor terbobot akhir dihitung mutlak oleh AI berdasarkan 10 kriteria evaluasi standar UMKM.</p>
          </div>

          <div class="flex items-center gap-2">
            <span class="text-xs text-slate-400">Status Penilaian:</span>
            <span id="audit-status-badge" class="px-3 py-1 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800 text-xs font-semibold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Selesai Dinilai AI
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-stretch">
          
          <!-- Score Card -->
          <div class="md:col-span-4 bg-slate-950/80 border border-slate-800 rounded-2xl p-6 flex flex-col items-center text-center justify-between relative overflow-hidden">
            <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-sky-500/10 rounded-full blur-2xl pointer-events-none"></div>

            <span class="text-xs uppercase tracking-wider font-bold text-slate-400 mb-1">Total Skor Terbobot</span>
            
            <div class="my-3">
              <span id="overall-score-display" class="text-5xl sm:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-indigo-400 to-emerald-400 font-mono">
                0.0%
              </span>
            </div>

            <div class="flex flex-col items-center gap-1.5 w-full">
              <span id="grade-badge" class="px-5 py-1.5 rounded-xl bg-slate-800 text-slate-300 border border-slate-700 text-xl font-black tracking-wide shadow-lg">
                GRADE -
              </span>
              <span id="grade-predicate" class="text-xs font-semibold text-slate-400 text-center">
                Menunggu Penilaian
              </span>
            </div>

            <div class="w-full mt-6 pt-4 border-t border-slate-800 text-left text-xs space-y-2">
              <div class="flex justify-between text-slate-400">
                <span>Kelompok 1-4 (45% UI/UX & Katalog):</span>
                <span id="cat-score-a" class="font-mono text-slate-200 font-bold">0.00 / 45</span>
              </div>
              <div class="flex justify-between text-slate-400">
                <span>Kelompok 5-6 (20% Keamanan & Admin):</span>
                <span id="cat-score-b" class="font-mono text-slate-200 font-bold">0.00 / 20</span>
              </div>
              <div class="flex justify-between text-slate-400">
                <span>Kelompok 7-9 (25% Resp & Info):</span>
                <span id="cat-score-c" class="font-mono text-slate-200 font-bold">0.00 / 25</span>
              </div>
              <div class="flex justify-between text-slate-400">
                <span>Kelompok 10 (10% Direct Checkout):</span>
                <span id="cat-score-d" class="font-mono text-slate-200 font-bold">0.00 / 10</span>
              </div>
            </div>
          </div>

          <!-- Radar Chart Visualizer -->
          <div class="md:col-span-4 bg-slate-950/80 border border-slate-800 rounded-2xl p-4 flex flex-col items-center justify-center min-h-[300px]">
            <h3 class="text-xs font-bold text-slate-300 mb-2 uppercase tracking-wider text-center">Pemetaan Radar Performa Kriteria</h3>
            <div class="w-full h-64 relative flex items-center justify-center">
              <canvas id="auditRadarChart"></canvas>
            </div>
          </div>

          <!-- Executive Summary Box -->
          <div class="md:col-span-4 bg-slate-950/80 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between space-y-3">
            <div>
              <h3 class="text-xs font-bold text-sky-400 uppercase tracking-wider flex items-center gap-1.5 mb-2">
                <i class="fa-solid fa-file-contract"></i> Ringkasan Analisis AI
              </h3>
              <p id="executive-summary-text" class="text-xs text-slate-300 leading-relaxed bg-slate-900/90 p-3.5 rounded-xl border border-slate-800">
                Silakan klik tombol "Nilai Prototipe Sekarang" untuk mengizinkan AI Gemini melakukan audit komprehensif terhadap URL website target.
              </p>
            </div>

            <button id="btn-view-report-modal" class="w-full py-2.5 bg-sky-600/20 hover:bg-sky-600/30 border border-sky-500/40 text-sky-300 text-xs font-semibold rounded-xl transition flex items-center justify-center gap-2">
              <i class="fa-solid fa-print"></i>
              <span>Buka Format Cetak PDF Resmi</span>
            </button>

            <button id="btn-share-public" class="w-full py-2.5 bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/40 text-emerald-300 text-xs font-semibold rounded-xl transition flex items-center justify-center gap-2">
              <i class="fa-solid fa-share-nodes"></i>
              <span>Publikasikan & Dapatkan Tautan Publik</span>
            </button>
          </div>

        </div>
      </section>

      <section id="public-repository-section" class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <div>
            <h2 class="text-base sm:text-lg font-bold text-slate-100 flex items-center gap-2">
              <i class="fa-solid fa-cloud text-sky-400"></i>
              Repositori Audit Publik UMKM (Real-Time Cloud)
            </h2>
            <p class="text-xs text-slate-400">Daftar laporan hasil penilaian prototipe UMKM yang dipublikasikan secara umum dan dapat diakses bersama.</p>
          </div>
          <span class="text-[11px] font-mono bg-sky-950 border border-sky-800 text-sky-400 px-3 py-1 rounded-full flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-sky-400 animate-ping"></span> Live Updates
          </span>
        </div>

        <div id="public-audits-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pt-2">
          <div class="col-span-full text-center py-8 text-slate-500 text-xs">
            <i class="fa-solid fa-spinner fa-spin text-xl text-sky-400 mb-2 block"></i>
            Memuat daftar audit publik dari cloud...
          </div>
        </div>
      </section>

      <section class="space-y-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <div>
            <h2 class="text-base sm:text-lg font-bold text-slate-100 flex items-center gap-2">
              <i class="fa-solid fa-list-check text-sky-400"></i>
              Matriks Penilaian Terperinci 10 Kriteria (Eksklusif AI)
            </h2>
            <p class="text-xs text-slate-400">Hasil audit mutlak dari AI Gemini beserta analisis alasan dan rekomendasi perbaikan.</p>
          </div>
          <div class="flex items-center gap-2 text-xs text-slate-400">
            <i class="fa-solid fa-shield-cat text-amber-400"></i>
            <span>Penilaian Terunci & Valid</span>
          </div>
        </div>

        <div class="space-y-8" id="matrix-container">
          <!-- Rendered dynamically via JS -->
        </div>
      </section>

    </div>

  </main>

  <!-- AI Progress Modal -->
  <div id="modal-ai-progress" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 text-center space-y-4 shadow-2xl">
      <div class="w-12 h-12 rounded-full bg-sky-500/20 text-sky-400 flex items-center justify-center mx-auto text-xl">
        <i class="fa-solid fa-brain animate-pulse"></i>
      </div>
      <div>
        <h3 class="font-bold text-slate-100 text-sm sm:text-base">AI Sedang Memproses Audit Prototipe</h3>
        <p id="ai-progress-status" class="text-xs text-slate-400 mt-1">Mengevaluasi struktur URL, tautan admin, dan kelengkapan katalog...</p>
      </div>
      <div class="w-full bg-slate-950 rounded-full h-2.5 overflow-hidden border border-slate-800">
        <div id="ai-progress-bar" class="bg-gradient-to-r from-sky-500 to-indigo-500 h-2.5 rounded-full transition-all duration-300 w-1/4"></div>
      </div>
    </div>
  </div>

  <!-- API Key Modal -->
  <div id="modal-api-key" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="font-bold text-slate-100 text-sm sm:text-base flex items-center gap-2">
          <i class="fa-solid fa-key text-amber-400"></i> Pengaturan Kunci Gemini API
        </h3>
        <button id="btn-close-api-modal" class="text-slate-400 hover:text-slate-200">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <p class="text-xs text-slate-400 leading-relaxed">
        Model default yang digunakan adalah <code class="bg-slate-950 px-1.5 py-0.5 rounded text-sky-400 font-mono">gemini-3-flash-preview</code>. Dalam lingkungan runtime Canvas, kunci API terpasang secara otomatis.
      </p>

      <div class="space-y-1.5">
        <label for="custom-api-key" class="text-xs font-semibold text-slate-300">Gemini API Key (Opsional / Custom):</label>
        <input type="password" id="custom-api-key" placeholder="Masukkan Custom Gemini API Key..." class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-sky-500 font-mono">
      </div>

      <div class="flex justify-end gap-2 pt-2">
        <button id="btn-save-api-key" class="px-4 py-2 bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold rounded-xl transition">
          Simpan & Gunakan
        </button>
      </div>
    </div>
  </div>

  <div id="print-report-modal" class="hidden fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md overflow-y-auto p-4 sm:p-8">
    <div class="max-w-4xl mx-auto bg-white text-slate-900 rounded-2xl shadow-2xl p-8 space-y-6 my-8">
      
      <!-- Report Header -->
