        }

        listenPublicAudits();
        checkUrlForAuditParam();
      } catch (err) {
        console.warn("Cloud Storage offline mode fallback:", err);
      }
    }

    async function publishAuditToPublic() {
      if (!db || !currentUser) {
        showToast("Mode Offline", "Koneksi cloud belum siap. Coba beberapa saat lagi.", false);
        return;
      }

      try {
        const { doc, setDoc } = window.FirebaseSDK;
        const auditId = "audit_" + Date.now();
        const publicDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'public_audits', auditId);

        let totalWeighted = 0;
        for (let key in state.criteriaMeta) {
          totalWeighted += (state.auditData.scores[key] || 0) * state.criteriaMeta[key].weight;
        }

        const payload = {
          id: auditId,
          url: state.url,
          score: totalWeighted,
          auditData: state.auditData,
          createdAt: new Date().toISOString(),
          publisherId: currentUser.uid
        };

        await setDoc(publicDocRef, payload);

        const shareUrl = `${window.location.origin}${window.location.pathname}?auditId=${auditId}`;
        
        const tempInput = document.createElement('input');
        tempInput.value = shareUrl;
        document.body.appendChild(tempInput);
        tempInput.select();
        document.execCommand('copy');
        document.body.removeChild(tempInput);

        showToast("Audit Dipublikasikan!", "Hasil audit tersimpan di cloud & tautan publik disalin ke clipboard.", true);
      } catch (err) {
        console.error("Gagal mempublikasikan audit:", err);
        showToast("Gagal Mempublikasikan", "Terjadi kesalahan saat menyimpan ke repositori publik.", false);
