        if (resultsSection) resultsSection.classList.remove('hidden');
        renderMatrixCards();
        updateDashboardDisplays();
        resultsSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        showToast("Hasil Terkonsistensi", "Memuat hasil audit yang identik dari memori cache (Temp 0.0).", true);
        return;
      }

      const progressModal = document.getElementById('modal-ai-progress');
      const progressBar = document.getElementById('ai-progress-bar');
      const progressStatus = document.getElementById('ai-progress-status');

      if (progressModal) progressModal.classList.remove('hidden');
      if (progressBar) progressBar.style.width = '20%';

      try {
        if (progressStatus) progressStatus.textContent = "Melakukan analisis konteks web & pemindaian tautan admin...";
        if (progressBar) progressBar.style.width = '50%';

        const systemPrompt = `Anda adalah Auditor AI Resmi untuk Prototipe WebApp UMKM.
Tugas Anda adalah menilai URL website katalog produk UMKM secara obyektif berdasarkan 10 kriteria:
1. c1: Fungsionalitas Elemen (tombol, filter, navigasi)
2. c2: Tata Letak Elemen (grid produk, spacing, hierarki visual)
3. c3: UI/UX User Friendly (kontras, kenyamanan, keterbacaan)
4. c4: Gambar Katalog & Keterangan (kualitas foto, rincian produk)
5. c5: Pemisahan Akses Admin & Pengunjung (WAJIB PERIKSA apakah ada tautan 'Portal Admin', 'Login Pengelola', '/admin', atau tombol kelola pada navbar/footer. Jika ada, berikan skor tinggi 85-100 dan sebutkan lokasinya)
6. c6: Ketahanan Anti SQL Injection (sanitasi input, validasi form)
7. c7: Tampilan Dynamic / Responsive (adaptabilitas desktop, tablet, mobile)
8. c8: Informasi Kontak Perusahaan Lengkap (alamat, WhatsApp, email)
9. c9: Mekanisme Belanja / Checkout Dijelaskan (alur pemesanan transparan)
10. c10: Direct Checkout & Metode Pembayaran (WA, QRIS, Transfer)

Format output WAJIB JSON persis seperti berikut:
{
  "executive_summary": "Ringkasan analisis eksekutif...",
  "scores": { "c1": 90, "c2": 85, "c3": 88, "c4": 92, "c5": 88, "c6": 80, "c7": 90, "c8": 95, "c9": 85, "c10": 90 },
  "reasons": { "c1": "...", "c2": "...", "c3": "...", "c4": "...", "c5": "...", "c6": "...", "c7": "...", "c8": "...", "c9": "...", "c10": "..." },
  "recommendations": { "c1": "...", "c2": "...", "c3": "...", "c4": "...", "c5": "...", "c6": "...", "c7": "...", "c8": "...", "c9": "...", "c10": "..." }
}`;

        const userPrompt = `Lakukan audit deterministik untuk URL Prototipe Website UMKM berikut: ${url}`;
        const apiKey = state.apiKey;
        const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

        if (progressBar) progressBar.style.width = '80%';

        let resultData = null;

        if (apiKey) {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [
                { role: 'user', parts: [{ text: systemPrompt + "\n\n" + userPrompt }] }
              ],
              generationConfig: {
                temperature: 0.0,
                response_mime_type: "application/json"
              }
            })
          });

          if (response.ok) {
            const resJson = await response.json();
            const textContent = resJson.candidates?.[0]?.content?.parts?.[0]?.text;
            if (textContent) {
              resultData = JSON.parse(textContent);
            }
          }
        }

        if (!resultData) {
          resultData = generateDeterminisitcFallback(url);
